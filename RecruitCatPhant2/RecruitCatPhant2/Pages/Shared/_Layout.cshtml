<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RecruitCatPhant2</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/RecruitCatPhant2.styles.css" asp-append-version="true" />
    <style>
            body {
                background-color: #DEE6E9;
            }

            h1, h2, h3 {
                color: #C70F2E;
            }

            .navbar-brand, .nav-link {
                color: #C70F2E;
                font-weight: 500;
            }

            .navbar-brand:hover, .nav-link:hover {
                    opacity: 0.8;
                }

            footer {
                background-color: #DEE6E9;
                color: #ffffff;
                padding: 12px 0;
                margin-top: 40px;
            }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-light bg-light">
            <div class="container">
                <a class="navbar-brand" asp-page="/Index">Cincinnati Recruiting Company</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav ms-auto">
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/OurTeam/Index">Our Team</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Candidates/Index">Candidates</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Companies/Index">Companies</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Industries/Index">Industries</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/JobTitles/Index">Job Titles</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - RecruitCatPhant2 - <a asp-area="" asp-page="/Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
