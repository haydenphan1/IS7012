@page
@model RecruitCatPhant2.Pages.Industries.CreateModel
@{
    ViewData["Title"] = "Create Industry";
}

<h1>Create Industry</h1>

<form method="post">
    <div class="form-group">
        <label asp-for="Industry.Name" class="control-label"></label>
        <input asp-for="Industry.Name" class="form-control" />
        <span asp-validation-for="Industry.Name" class="text-danger"></span>
    </div>
    <div class="form-group mt-2">
        <button type="submit" class="btn btn-primary">Create</button>
        <a asp-page="Index" class="btn btn-secondary">Back to List</a>
    </div>
</form>

@section Scripts{
    <partial name="_ValidationScriptsPartial" />
}
