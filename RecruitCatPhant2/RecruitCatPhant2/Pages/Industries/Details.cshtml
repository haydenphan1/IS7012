@page
@model RecruitCatPhant2.Pages.Industries.DetailsModel
@{
    ViewData["Title"] = "Industry Details";
}

<h1>Industry Details</h1>

<div>
    <h4>Industry</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            Name
        </dt>
        <dd class = "col-sm-10">
            @Model.Industry.Name
        </dd>
    </dl>
    <a asp-page="Edit" asp-route-id="@Model.Industry.Id" class="btn btn-primary">Edit</a>
    <a asp-page="Index" class="btn btn-secondary">Back to List</a>
</div>
