@page
@model RecruitCatPhant2.Pages.Industries.IndexModel
@{
    ViewData["Title"] = "Industries";
}

<h1>Industries</h1>

<p>
    <a class="btn btn-primary" asp-page="Create">Create New</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Name</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var item in Model.Industry)
    {
        <tr>
            <td>@item.Name</td>
            <td>
                <a class="btn btn-sm btn-secondary" asp-page="Edit" asp-route-id="@item.Id">Edit</a>
                <a class="btn btn-sm btn-info" asp-page="Details" asp-route-id="@item.Id">Details</a>
                <a class="btn btn-sm btn-danger" asp-page="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
    }
    </tbody>
</table>
