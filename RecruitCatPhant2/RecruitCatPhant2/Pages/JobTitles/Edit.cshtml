@page
@model RecruitCatPhant2.Pages.JobTitles.EditModel
@{
    ViewData["Title"] = "Edit Job Title";
}

<h1>Edit {JobTitle.Title}</h1>

<form method="post">
    <input type="hidden" asp-for="JobTitle.Id" />

    <div class="form-group">
        <label asp-for="JobTitle.Title" class="control-label">Title</label>
        <input asp-for="JobTitle.Title" class="form-control" />
        <span asp-validation-for="JobTitle.Title" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="JobTitle.Department" class="control-label">Department</label>
        <input asp-for="JobTitle.Department" class="form-control" />
        <span asp-validation-for="JobTitle.Department" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="JobTitle.EmploymentType" class="control-label">Employment Type</label>
        <input asp-for="JobTitle.EmploymentType" class="form-control" />
        <span asp-validation-for="JobTitle.EmploymentType" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="JobTitle.MinimumSalary" class="control-label">Minimum Salary</label>
        <input asp-for="JobTitle.MinimumSalary" class="form-control" />
        <span asp-validation-for="JobTitle.MinimumSalary" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="JobTitle.MaximumSalary" class="control-label">Maximum Salary</label>
        <input asp-for="JobTitle.MaximumSalary" class="form-control" />
        <span asp-validation-for="JobTitle.MaximumSalary" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-page="Index" class="btn btn-secondary">Back to List</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
