@page
@model RecruitCatPhant2.Pages.JobTitles.DeleteModel
@{
    ViewData["Title"] = "Delete Job Title";
}

<h1>Delete Job Title</h1>

<h3>Are you sure you want to delete this?</h3>
<div>
    <h4>JobTitle</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Title</dt>
        <dd class="col-sm-10">@Model.JobTitle.Title</dd>

        <dt class="col-sm-2">Department</dt>
        <dd class="col-sm-10">@Model.JobTitle.Department</dd>

        <dt class="col-sm-2">Employment Type</dt>
        <dd class="col-sm-10">@Model.JobTitle.EmploymentType</dd>
    </dl>
</div>

<form method="post">
    <input type="hidden" asp-for="JobTitle.Id" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-page="Index" class="btn btn-secondary">Back to List</a>
</form>
