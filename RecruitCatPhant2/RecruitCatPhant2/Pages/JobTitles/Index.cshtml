@page
@model RecruitCatPhant2.Pages.JobTitles.IndexModel
@{
    ViewData["Title"] = "Job Titles";
}

<h1>All Job Titles</h1>

<p>
    <a class="btn btn-primary" asp-page="Create">Create New</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Title</th>
            <th>Department</th>
            <th>Employment Type</th>
            <th>Min Salary</th>
            <th>Max Salary</th>
            <th>Candidates</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var item in Model.JobTitle)
    {
        <tr>
            <td>@item.Title</td>
            <td>@item.Department</td>
            <td>@item.EmploymentType</td>
            <td>@(item.MinimumSalary?.ToString("C") ?? "")</td>
            <td>@(item.MaximumSalary?.ToString("C") ?? "")</td>
            <td>@(item.Candidates?.Count ?? 0)</td>
            <td>
                    <a class="btn btn-sm btn-info" asp-page="Details" asp-route-id="@item.Id">Details</a> |
                    <a class="btn btn-sm btn-info" asp-page="Edit" asp-route-id="@item.Id">Edit</a> |
                    <a class="btn btn-sm btn-info" asp-page="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
    }
    </tbody>
</table>
