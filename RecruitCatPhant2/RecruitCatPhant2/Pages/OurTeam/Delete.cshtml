@page "{id:int}"
@model RecruitCatPhant2.Pages.OurTeam.DeleteModel
{
    ViewData["Title"] = "Delete Team Member";
}

<h1>Delete Team Member</h1>

<div>
    <h4>Are you sure you want to delete this member?</h4>
    <div>
        <strong>@Model.Member?.FullName</strong>
    </div>
    <form method="post">
        <input type="hidden" asp-for="Member.Id" value="@Model.Member?.Id" />
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-page="Index" class="btn btn-secondary">Cancel</a>
    </form>

</div>
