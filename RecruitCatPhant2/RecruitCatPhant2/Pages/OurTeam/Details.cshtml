@page "{id:int}"
@model RecruitCatPhant2.Pages.OurTeam.DetailsModel
{
    ViewData["Title"] = "Team Member Details";
}

<h1>Team Member Details</h1>

<div>
    <h4>@Model.Member?.FullName</h4>
    <dl class="row">
        <dt class="col-sm-2">Role</dt>
        <dd class="col-sm-10">@Model.Member?.Role</dd>

        <dt class="col-sm-2">Bio</dt>
        <dd class="col-sm-10">@Model.Member?.Bio</dd>

        <dt class="col-sm-2">Photo</dt>
        <dd class="col-sm-10">@if (!string.IsNullOrEmpty(Model.Member?.PhotoUrl)) { <img src="@Model.Member.PhotoUrl" alt="@Model.Member.FullName" style="max-width:150px;" /> } else { <span>No photo</span> }</dd>
    </dl>
</div>

<a asp-page="Index" class="btn btn-secondary">Back</a>
