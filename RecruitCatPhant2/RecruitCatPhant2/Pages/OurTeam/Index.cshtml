@page
@model RecruitCatPhant2.Pages.OurTeam.IndexModel
@{
    ViewData["Title"] = "Our Team";
}
<style>
    .text-center {
        text-align: justify;
    }

    .center-image {
        display: block;
        margin-left: auto;
        margin-right: auto;
    }
</style>

<h1 class="text-center">Our Team</h1>

<p class="text-center">
    <em>At Cincinnati Recruiting Company, our team combines local market expertise with a candidate-first mindset. Meet the people who make our recruiting process personal, transparent, and effective. </em>
</p>
<hr />

<div class="row">
    <div class="col-md-4">
        <img src="https://media.licdn.com/dms/image/v2/D5603AQHtfywZu4uAbQ/profile-displayphoto-shrink_800_800/profile-displayphoto-shrink_800_800/0/1730142625335?e=1790208000&v=beta&t=mfws_glNMB9zIQTA8eHEV7ZTGGCG3JCOp1hfbsv9qHM" class="center-image" alt="Headshot" width="400" height="400">
        <h3>Hayden Phan</h3>
        <p><strong>Founder & Lead Talent Strategist</strong></p>
        <p>
            Hayden started Cincinnati Recruiting Company with a simple goal: <em>"Prioritize people over placements."</em> With a background in technology and business, Hayden specializes in matching IT and analytics professionals with growth-minded companies across the Cincinnati region.
        </p>
        <p>
            When not reviewing resumes or coaching candidates, hayden enjoys exploring local coffee shops and mentoring students who are just starting their careers.
        </p>
    </div>

    <div class="col-md-4">
        <img src="https://assets.headshotkiwi.com/samples/43.webp" class="center-image" alt="Headshot" width="400" height="400">
        <h3>John Doe</h3>
        <p><strong>Senior Recruiter, Healthcare & Finance</strong></p>
        <p>
            John brings over seven years of recruiting experience in healthcare administration and financial services. Known for clear communication and honest feedback, John partners closely with hiring managers to understand their teams and long-term goals.
        </p>
        <p>
            John leads our employer branding initiatives, helping clients resent compelling stores that attract high-quality candidates.
        </p>
    </div>

    <div class="col-md-4">
        <img src="https://images.squarespace-cdn.com/content/v1/6091c3e4f5f6071721c43f77/1683711745725-O1R2JQOY9II73V828PYS/Midjourney+Headshot.jpg" class="center-image" alt="Headshot" width="400" height="400">
        <h3>Jane Doe</h3>
        <p><strong>Candidate Experience Coordinator</strong></p>
        <p>
            Jane ensures every candidate has a smooth, respectful experience-from first contact to onboarding. Jane manages interview scheduling, status updates, and post-hire check-ins, making sure no one feels "left in the dark" during the process.
        </p>
        <p>
            Jane is passionate about accessibility in hiring and works to make our web-based application process inclusive and easy to use.
        </p>
    </div>
</div>