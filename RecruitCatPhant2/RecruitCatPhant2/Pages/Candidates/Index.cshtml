@page
@model RecruitCatPhant2.Pages.Candidates.IndexModel
@{
    ViewData["Title"] = "Candidates";
}

<h1>Candidates</h1>

<p>
    <a class="btn btn-primary" asp-page="Create">Create New</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>First Name</th>
            <th>Last Name</th>
            <th>Email</th>
            <th>Experience</th>
            <th>Target Salary</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var item in Model.Candidate)
    {
        <tr>
            <td>@item.FirstName</td>
            <td>@item.LastName</td>
            <td>@item.Email</td>
            <td>@item.YearExperience</td>
            <td>@item.TargetSalary</td>
            <td>
                <a class="btn btn-sm btn-secondary" asp-page="Edit" asp-route-id="@item.Id">Edit</a>
                <a class="btn btn-sm btn-info" asp-page="Details" asp-route-id="@item.Id">Details</a>
                <a class="btn btn-sm btn-danger" asp-page="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
    }
    </tbody>
</table>
