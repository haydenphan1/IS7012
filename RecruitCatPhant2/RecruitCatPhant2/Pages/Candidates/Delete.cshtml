@page
@model RecruitCatPhant2.Pages.Candidates.DeleteModel
@{
    ViewData["Title"] = "Delete Candidate";
}

<h1>Delete Candidate - {Candidate.FirstName} {Candidate.LastName}</h1>

<h3>Are you sure you want to delete this?</h3>
<div>
    <h4>Candidate</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">First Name</dt>
        <dd class = "col-sm-10">@Model.Candidate.FirstName</dd>

        <dt class = "col-sm-2">Last Name</dt>
        <dd class = "col-sm-10">@Model.Candidate.LastName</dd>

        <dt class = "col-sm-2">Email</dt>
        <dd class = "col-sm-10">@Model.Candidate.Email</dd>
    </dl>

    <form method="post">
        <input type="hidden" asp-for="Candidate.Id" />
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-page="Index" class="btn btn-secondary">Back to List</a>
    </form>
</div>
