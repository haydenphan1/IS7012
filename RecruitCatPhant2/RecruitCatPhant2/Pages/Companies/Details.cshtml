@page
@model RecruitCatPhant2.Pages.Companies.DetailsModel
@{
    ViewData["Title"] = "Company Details";
}

<h1>Company: {Company.Name}</h1>

<div>
    <h4>Company</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Name</dt>
        <dd class="col-sm-10">@Model.Company.Name</dd>

        <dt class="col-sm-2">Website</dt>
        <dd class="col-sm-10">@Model.Company.Website</dd>

        <dt class="col-sm-2">Remote</dt>
        <dd class="col-sm-10">@(Model.Company.IsRemote == true ? "Yes" : "No")</dd>

        <dt class="col-sm-2">Position</dt>
        <dd class="col-sm-10">@Model.Company.Position</dd>

        <dt class="col-sm-2">Salary Range</dt>
        <dd class="col-sm-10">@Model.Company.MinimumSalary - @Model.Company.MaximumSalary</dd>

        <dt class="col-sm-2">Start Date</dt>
        <dd class="col-sm-10">@(Model.Company.StartDate?.ToString("yyyy-MM-dd"))</dd>

        <dt class="col-sm-2">Location</dt>
        <dd class="col-sm-10">@Model.Company.Location</dd>

        <dt class="col-sm-2">Industry</dt>
        <dd class="col-sm-10">@Model.Company.Industry?.Name</dd>
    </dl>

    <h5>Candidates</h5>
    @if (Model.Company.Candidates != null && Model.Company.Candidates.Any())
    {
        <ul class="list-group">
        @foreach (var cand in Model.Company.Candidates)
        {
            <li class="list-group-item">@cand.FirstName @cand.LastName</li>
        }
        </ul>
    }
    else
    {
        <p>No candidates associated.</p>
    }

    <a asp-page="Edit" asp-route-id="@Model.Company.Id" class="btn btn-primary">Edit</a>
    <a asp-page="Index" class="btn btn-secondary">Back to List</a>
</div>
