@page
@model RecruitCatPhant2.Pages.Companies.IndexModel
@{
    ViewData["Title"] = "Companies";
}

<h1>All Companies</h1>

<p>
    <a class="btn btn-primary" asp-page="Create">Create New</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Name</th>
            <th>Website</th>
            <th>Position</th>
            <th>Remote</th>
            <th>Industry</th>
            <th>Start Date</th>
            <th>Salary Range</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var item in Model.Company)
    {
        <tr>
            <td>@item.Name</td>
            <td>@item.Website</td>
            <td>@item.Position</td>
            <td>@(item.IsRemote == true ? "Yes" : "No")</td>
            <td>@item.Industry?.Name</td>
            <td>@(item.StartDate?.ToString("yyyy-MM-dd"))</td>
            <td>@(item.MinimumSalary?.ToString() ?? "") - @(item.MaximumSalary?.ToString() ?? "")</td>
            <td>
                    <a class="btn btn-sm btn-info" asp-page="Details" asp-route-id="@item.Id">Details</a> |
                    <a class="btn btn-sm btn-info" asp-page="Edit" asp-route-id="@item.Id">Edit</a> |
                    <a class="btn btn-sm btn-info" asp-page="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
    }
    </tbody>
</table>
