@page
@model RecruitCatPhant2.Pages.Companies.DeleteModel
@{
    ViewData["Title"] = "Delete Company";
}

<h1>Delete Company - {Company.Name}</h1>

<h3>Are you sure you want to delete this?</h3>
<div>
    <h4>Company</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Name</dt>
        <dd class="col-sm-10">@Model.Company.Name</dd>
        <dt class="col-sm-2">Industry</dt>
        <dd class="col-sm-10">@Model.Company.Industry?.Name</dd>
    </dl>

    <form method="post">
        <input type="hidden" asp-for="Company.Id" />
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-page="Index" class="btn btn-secondary">Back to List</a>
    </form>
</div>
