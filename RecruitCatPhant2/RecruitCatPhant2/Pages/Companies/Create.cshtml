@page
@model RecruitCatPhant2.Pages.Companies.CreateModel
@{
    ViewData["Title"] = "Create Company";
}

<h1>Create Company</h1>

<form method="post">
    <div class="mb-3">
        <label asp-for="Company.Name" class="form-label"></label>
        <input asp-for="Company.Name" class="form-control" />
        <span asp-validation-for="Company.Name" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Company.Website" class="form-label"></label>
        <input asp-for="Company.Website" class="form-control" />
        <span asp-validation-for="Company.Website" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Company.Position" class="form-label"></label>
        <input asp-for="Company.Position" class="form-control" />
        <span asp-validation-for="Company.Position" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Company.Location" class="form-label"></label>
        <input asp-for="Company.Location" class="form-control" />
        <span asp-validation-for="Company.Location" class="text-danger"></span>
    </div>
    <div class="mb-3 form-check">
        <input asp-for="Company.IsRemote" class="form-check-input" />
        <label asp-for="Company.IsRemote" class="form-check-label"></label>
    </div>
    <div class="mb-3">
        <label asp-for="Company.MinimumSalary" class="form-label"></label>
        <input asp-for="Company.MinimumSalary" class="form-control" />
        <span asp-validation-for="Company.MinimumSalary" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Company.StartDate" class="form-label"></label>
        <input asp-for="Company.StartDate" class="form-control" />
        <span asp-validation-for="Company.StartDate" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Create</button>
    <a asp-page="Index" class="btn btn-secondary">Back to list</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
