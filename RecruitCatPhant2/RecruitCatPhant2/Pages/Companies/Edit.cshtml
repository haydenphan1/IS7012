@page
@model RecruitCatPhant2.Pages.Companies.EditModel
@{
    ViewData["Title"] = "Edit Company";
}

<h1>Edit - @Model.Company.Name</h1>

<form method="post">
    <input type="hidden" asp-for="Company.Id" />
    <div class="form-group">
        <label asp-for="Company.Name" class="control-label">Name</label>
        <input asp-for="Company.Name" class="form-control" />
        <span asp-validation-for="Company.Name" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Company.Website" class="control-label">Website</label>
        <input asp-for="Company.Website" class="form-control" />
    </div>
    <div class="form-group form-check">
        <input asp-for="Company.IsRemote" class="form-check-input" />
        <label asp-for="Company.IsRemote" class="form-check-label">Is Remote</label>
    </div>
    <div class="form-group">
        <label asp-for="Company.Position" class="control-label">Position</label>
        <input asp-for="Company.Position" class="form-control" />
    </div>
    <div class="form-group">
        <label asp-for="Company.MinimumSalary" class="control-label">Minimum Salary</label>
        <input asp-for="Company.MinimumSalary" class="form-control" />
    </div>
    <div class="form-group">
        <label asp-for="Company.MaximumSalary" class="control-label">Maximum Salary</label>
        <input asp-for="Company.MaximumSalary" class="form-control" />
    </div>
    <div class="form-group">
        <label asp-for="Company.StartDate" class="control-label">Start Date</label>
        <input asp-for="Company.StartDate" type="date" class="form-control" />
    </div>
    <div class="form-group">
        <label asp-for="Company.Location" class="control-label">Location</label>
        <input asp-for="Company.Location" class="form-control" />
    </div>
    <div class="form-group">
        <label asp-for="Company.IndustryId" class="control-label">Industry</label>
        <select asp-for="Company.IndustryId" class="form-control" asp-items="ViewBag.IndustryId"></select>
    </div>

    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-page="Index" class="btn btn-secondary">Back to List</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
